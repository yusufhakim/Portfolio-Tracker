# Finnhub API key for US equities/ETFs (free tier: https://finnhub.io/register)
FINNHUB_API_KEY=

# Base currency the whole portfolio is normalized to (USD or INR)
BASE_CURRENCY=USD

# SQLAlchemy database URL (default: local SQLite file)
DATABASE_URL=sqlite:///./portfolio.db

# Single-user id used in Stage 1 (multi-user auth comes later)
DEFAULT_USER_ID=1

# Comma-separated CORS origins allowed to call the API (Expo dev server, etc.)
# Use * to allow all during local development.
CORS_ORIGINS=*
