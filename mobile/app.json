{
  "expo": {
    "name": "Portfolio Tracker",
    "slug": "portfolio-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "portfoliotracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yusufhakim.portfoliotracker"
    },
    "android": {
      "package": "com.yusufhakim.portfoliotracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-background-task"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "finnhubApiKey": "d9rn9chr01qoo7o51nggd9rn9chr01qoo7o51nh0"
    }
  }
}
