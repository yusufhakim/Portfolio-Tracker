{
  "expo": {
    "name": "Portfolio Tracker",
    "slug": "portfolio-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "portfoliotracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yusufhakim.portfoliotracker"
    },
    "android": {
      "package": "com.yusufhakim.portfoliotracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E14"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Portfolio Tracker to unlock the app with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "finnhubApiKey": "d9rn9chr01qoo7o51nggd9rn9chr01qoo7o51nh0"
    }
  }
}
